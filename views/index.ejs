<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Index</title>
</head>

<body>
    <% for(let i=0; i < messages.length; i++) { %>
        <span>User: <%= messages[i].user %></span>
        <p>Message: <span>
                <%= messages[i].text %>
            </span></p>
        <p>
            <%= messages[i].added %>
        </p>
        <button><a href="/see-message/<%= i %>">View Message</a></button>
        <hr>
        <% }%>

            <button><a href="/new">New Message</a></button>
</body>

</html>